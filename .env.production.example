# Production settings checklist. Copy to .env on the server and fill in every empty value. No secrets in git.
APP_NAME="Your Product"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://app.example.com
# Hosts besides APP_URL's that may appear in the Host header, e.g. 127.0.0.1 for the bundled nginx healthcheck.
TRUSTED_HOSTS=127.0.0.1
# Set to your reverse proxy / load balancer IPs or CIDRs (or * only if the app is reachable solely through it).
TRUSTED_PROXIES=

LOG_LEVEL=warning

# Sessions and cookies: HTTPS only, encrypted.
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=app.example.com

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
REDIS_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Billing: the fake driver is refused outside local/testing.
BILLING_ENABLED=true
BILLING_DRIVER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PRO=

# Invoicing: with a real billing driver the app will not boot (outside local/testing) until the seller is valid.
INVOICING_SELLER_NAME=
INVOICING_SELLER_ADDRESS=
INVOICING_SELLER_GSTIN=
INVOICING_SELLER_STATE_CODE=
INVOICING_SELLER_PAN=
INVOICING_SELLER_EMAIL=

HEALTH_TOKEN=
SUPPORT_INBOUND_TOKEN=
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
