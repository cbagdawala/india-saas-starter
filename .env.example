APP_NAME="India SaaS Starter Kit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8200

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,stderr
LOG_LEVEL=debug

# Database: MySQL 8 from docker-compose.yml. Use DB_HOST=127.0.0.1 and DB_PORT=3307 when running artisan on the host.
DB_CONNECTION=mysql
DB_HOST=starter-mysql
DB_PORT=3306
DB_DATABASE=india_saas_starter
DB_USERNAME=starter
DB_PASSWORD=change-me

# Redis from docker-compose.yml (requirepass = REDIS_PASSWORD).
REDIS_CLIENT=predis
REDIS_HOST=starter-redis
REDIS_PASSWORD=change-me
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=starter_
CACHE_PREFIX=starter_cache_

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=starter_session
CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

# Sanctum SPA cookie auth
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8200,localhost:5173,127.0.0.1,127.0.0.1:8200

# Host header allow-list outside local/testing: APP_URL's host plus these (comma list, exact match),
# e.g. an internal alias an uptime monitor uses.
# Empty by default. In production add the hosts your own health checks / monitors use (e.g. 127.0.0.1 for the compose
# nginx healthcheck); anything else gets 400. Emailed links never depend on the Host header: they are built from APP_URL.
TRUSTED_HOSTS=

PRODUCT_SLUG=starter

# /health: detailed fields (db, cache, queue, scheduler heartbeat, build SHA) only with header
# X-Health-Token matching this value (>= 32 chars, else details are never shown; generate with: openssl rand -hex 32).
# BUILD_SHA is set by the image build / deploy (git rev-parse --short HEAD).
HEALTH_TOKEN=
BUILD_SHA=
SCHEDULER_STALE_AFTER=300

# Support inbox (optional): Brevo inbound-parse webhook -> POST /api/support/inbound with `Authorization: Bearer <token>`
# or basic auth (any user, token as password). Never in the URL query. >= 32 chars, empty = refuse everything.
SUPPORT_INBOUND_TOKEN=
# authserv-id of the receiving MX whose Authentication-Results header is trusted for sender verification
# (inbound tickets are linked to a user only when DMARC/DKIM/SPF pass aligned). Empty = never verified.
SUPPORT_TRUSTED_AUTHSERV_ID=
SUPPORT_ADDRESS=

# Billing: fake (local/testing only; boot fails in production) | razorpay (TEST mode keys only: rzp_test_*). Unknown values fail at boot.
BILLING_DRIVER=fake
# false = this product has no billing: no driver is resolved at boot (so production needs no razorpay keys) and /api/billing routes are not registered.
BILLING_ENABLED=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PRO=

# GlitchTip / Sentry error reporting (optional). Empty DSN = off.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false

# Plausible analytics (optional; the script tag renders only when both are set)
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SRC=
# If you enable Plausible, add its origin to script-src and connect-src in docker/nginx/default.conf.

# Mail (Mailpit)
MAIL_MAILER=smtp
MAIL_HOST=starter-mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Production overrides ---
# APP_ENV=production
# APP_DEBUG=false
# LOG_LEVEL=warning
# SESSION_SECURE_COOKIE=true
# SESSION_ENCRYPT=true
# SANCTUM_STATEFUL_DOMAINS=app.example.com

# Docker (see README.md)
HOST_UID=501
HOST_GID=20

# Multi-tenancy: invitation link lifetime (days) and cap on open invitations per workspace
TENANCY_INVITATION_TTL_DAYS=7
TENANCY_MAX_PENDING_INVITATIONS=50
TENANCY_MAX_INVITATIONS_PER_DAY=100
TENANCY_MAX_INVITATIONS_PER_USER_PER_DAY=50

# Invoicing (GST tax invoices): the SELLER printed on every invoice. Placeholders only; use your real registration.
# Issuing refuses to run until legal name, address, GSTIN and matching state code are valid.
# 27AAPFU0939F1ZV is a published example GSTIN, not a real registration.
INVOICING_SELLER_NAME=
INVOICING_SELLER_ADDRESS=
INVOICING_SELLER_GSTIN=
INVOICING_SELLER_STATE_CODE=
INVOICING_SELLER_PAN=
INVOICING_SELLER_EMAIL=
INVOICING_PREFIX=INV
INVOICING_CREDIT_NOTE_PREFIX=CN
INVOICING_SAC=998314
INVOICING_GST_RATE_PERCENT=18
# true = plan prices already include GST (the gateway charge is the invoice total)
INVOICING_PRICES_INCLUDE_TAX=true
# lut = zero-rated export under a Letter of Undertaking; igst = charge IGST
INVOICING_EXPORT_MODE=lut
# UPI for unpaid manual invoices (a UPI link never confirms payment by itself)
INVOICING_UPI_VPA=
INVOICING_UPI_PAYEE_NAME=

# Reverse proxy IPs/CIDRs whose X-Forwarded-* headers are trusted (comma list, or * behind a proxy you control). Empty = none.
TRUSTED_PROXIES=
